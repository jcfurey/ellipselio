Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 70; 75; 85
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: EllipseLIO map (height)
      Enabled: true
      Alpha: 1
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Axis: Z
      Autocompute Value Bounds:
        Value: false
        Min Value: -2
        Max Value: 10
      Decay Time: 12
      Size (Pixels): 2
      Style: Points
      Selectable: true
      Topic:
        Value: /cloud_map
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Filter size: 10
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Current scan
      Enabled: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 245; 245; 245
      Position Transformer: XYZ
      Decay Time: 0
      Size (Pixels): 3
      Style: Points
      Topic:
        Value: /cloud_scan
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Filter size: 10
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry trail
      Enabled: true
      Keep: 500
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 100; 70
        Alpha: 1
        Shaft Length: 0.3
        Shaft Radius: 0.025
        Head Length: 0.12
        Head Radius: 0.06
      Covariance:
        Value: false
      Topic:
        Value: /ellipselio_odom
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Sensor frames
      Enabled: true
      Frames:
        All Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Show Axes: true
      Show Arrows: false
      Show Names: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 27; 33
    Fixed Frame: odom_ellipselio
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Pitch: 0.75
      Yaw: 0.8
      Near Clip Distance: 0.01
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: imu_ellipselio
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Width: 1440
  Height: 900
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
